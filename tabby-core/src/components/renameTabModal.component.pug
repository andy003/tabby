.modal-header(*ngIf='title')
    h4.modal-title {{title}}

.modal-body
    input.form-control(type='text', #input, [(ngModel)]='value', [attr.aria-label]='title', (keyup.enter)='save()', autofocus)

.modal-footer
    button.btn.btn-primary((click)='save()', [disabled]='requireNonEmpty && !value.trim()', translate) Save
    button.btn.btn-secondary((click)='close()', translate) Cancel
