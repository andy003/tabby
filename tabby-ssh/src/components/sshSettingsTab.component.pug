h3 SSH

ng-container(*ngIf='hostApp.platform !== Platform.Web')
    .form-line
        .header
            .title(translate) Remote file editor
            .description(translate) Used when double-clicking remote files. Saving uploads your changes automatically.
        select.form-control(
            [(ngModel)]='config.store.ssh.fileEditor',
            (ngModelChange)='config.save()',
            [attr.aria-label]='"Remote file editor"|translate'
        )
            option(value='system', translate) System text editor
            option(value='vscode', translate) Visual Studio Code
            option(value='custom', translate) Custom application

    .form-line(*ngIf='config.store.ssh.fileEditor === "custom"')
        .header
            .title(translate) Editor application
            .description(translate) Choose the application used to edit remote files.
        .input-group
            input.form-control(
                type='text',
                [(ngModel)]='config.store.ssh.fileEditorPath',
                [title]='config.store.ssh.fileEditorPath',
                (change)='config.save()',
                [attr.aria-label]='"Editor application"|translate',
                [placeholder]='"Application path"|translate'
            )
            button.btn.btn-secondary(type='button', (click)='pickEditor()', [ngbTooltip]='"Select text editor"|translate', [attr.aria-label]='"Select text editor"|translate')
                i.fas.fa-folder-open

.form-line
    .header
        .title(translate) Open the SFTP browser when connecting
        .description(translate) Keep remote files beside the terminal.
    toggle(
        [(ngModel)]='config.store.ssh.autoOpenSFTP',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate) Warn when closing active connections
    toggle(
        [(ngModel)]='config.store.ssh.warnOnClose',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate) Verify host keys when connecting
    toggle(
        [(ngModel)]='config.store.ssh.verifyHostKeys',
        (ngModelChange)='config.save()',
    )

.form-line(*ngIf='hostApp.platform === Platform.Windows')
    .header
        .title(translate) WinSCP path
        .description(translate) When WinSCP is detected, you can launch an SCP session from the context menu.
    input.form-control(
        type='text',
        [placeholder]='"Auto-detect"|translate',
        [(ngModel)]='config.store.ssh.winSCPPath',
        (ngModelChange)='config.save()',
    )

.form-line(*ngIf='hostApp.platform === Platform.Windows')
    .header
        .title(translate) Agent type
        .description(translate) Forces a specific SSH agent connection type.
    select.form-control(
        [(ngModel)]='config.store.ssh.agentType',
        (ngModelChange)='config.save()',
    )
        option(value='auto', translate) Automatic
        option(value='pageant') Pageant
        option(value='pipe', translate) Named pipe

.form-line(*ngIf='config.store.ssh.agentType === "pipe"')
    .header
        .title(translate) Agent pipe path
        .description(translate) Sets the SSH agent's named pipe path.
    input.form-control(
        type='text',
        [placeholder]='"Default pipe path"|translate',
        [(ngModel)]='config.store.ssh.agentPath',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate) Override X11 display
        .description(translate) Path or address of the local X11 socket
    input.form-control(
        type='text',
        [placeholder]='defaultX11Display',
        [(ngModel)]='config.store.ssh.x11Display',
        (ngModelChange)='config.save()'
    )

.alert.alert-info(translate) SSH connection management is now done through the "Profiles & connections" tab
