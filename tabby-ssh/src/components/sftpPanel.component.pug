.header
    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='navigate(path)', [ngbTooltip]='"Refresh"|translate', [attr.aria-label]='"Refresh"|translate')
        i.fas.fa-sync-alt.me-1([class.fa-spin]='sftp && fileList === null')
        div(translate) Refresh

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(*ngIf='!showFilter', (click)='showFilter = true', [ngbTooltip]='"Filter"|translate', [attr.aria-label]='"Filter"|translate')
        i.fas.fa-filter.me-1
        div(translate) Filter

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='openCreateDirectoryModal()', [ngbTooltip]='"Create directory"|translate', [attr.aria-label]='"Create directory"|translate')
        i.fas.fa-plus.me-1
        div(translate) Create directory

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='upload()', [ngbTooltip]='"Upload files"|translate', [attr.aria-label]='"Upload files"|translate')
        i.fas.fa-upload.me-1
        div(translate) Upload files

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='uploadFolder()', [ngbTooltip]='"Upload folder"|translate', [attr.aria-label]='"Upload folder"|translate')
        i.fas.fa-upload.me-1
        div(translate) Upload folder

    button.btn.btn-link.text-decoration-none((click)='close()', [ngbTooltip]='"Close"|translate', [attr.aria-label]='"Close"|translate') !{require('../../../tabby-core/src/icons/times.svg')}

.path-bar
    form.input-group.input-group-sm((ngSubmit)='confirmPath()')
        span.input-group-text.path-icon(aria-hidden='true')
            i.far.fa-folder-open
        input.form-control(
            type='text',
            name='remotePath',
            [attr.aria-label]='"Remote path"|translate',
            [title]='path',
            autocomplete='off',
            spellcheck='false',
            [disabled]='!sftp || fileList === null',
            [ngModel]='editingPath ?? path',
            (ngModelChange)='editingPath = $event',
            (keydown.escape)='editingPath = null; $event.preventDefault()'
        )
        button.btn.btn-secondary(
            type='submit',
            [disabled]='!sftp || fileList === null',
            [ngbTooltip]='"Go to path"|translate',
            [attr.aria-label]='"Go to path"|translate'
        )
            i.fas.fa-arrow-right

.filter-bar.px-3.py-2.border-bottom(*ngIf='showFilter')
    .input-group
        input.form-control(
            type='text',
            [placeholder]='"Filter..."|translate',
            autofocus,
            [(ngModel)]='filterText',
            (input)='onFilterChange()',
            (keydown.escape)='clearFilter()'
        )
        button.btn.btn-secondary((click)='clearFilter()')
            i.fas.fa-times

.body(dropZone, (transfer)='uploadOneFolder($event)')
    a.alert.alert-info.d-flex.align-items-center(
        *ngIf='shouldShowCWDTip && !cwdDetectionAvailable',
        (click)='platform.openExternal("https://tabby.sh/go/cwd-detection")'
    )
        .me-auto
            strong(translate) Working directory detection
            div(translate) Learn how to allow Tabby to detect remote shell's working directory.
        button.close((click)='dismissCWDTip()')
            i.fas.fa-close

    div(*ngIf='!sftp && !connectionError', translate) Connecting
    .alert.alert-danger(*ngIf='connectionError', role='alert')
        p {{connectionError}}
        button.btn.btn-secondary(type='button', (click)='ngOnInit()', translate) Retry
    div(*ngIf='sftp')
        div(*ngIf='fileList === null', translate) Loading
        .list-group.list-group-light(*ngIf='fileList !== null')
            .list-group-item.list-group-item-action.d-flex.align-items-center(
                *ngIf='path !== "/" && (!showFilter || filterText.trim() === "")',
                (click)='goUp()'
            )
                i.fas.fa-fw.fa-level-up-alt
                div(translate) Go up
            .list-group-item.list-group-item-action.d-flex.align-items-center(
                *ngFor='let item of filteredFileList',
                (contextmenu)='showContextMenu(item, $event)',
                [class.selected]='selectedFile?.fullPath === item.fullPath',
                (click)='selectedFile = item',
                (dblclick)='open(item)',
                (keydown.enter)='open(item)',
                tabindex='0',
                role='button'
            )
                i.fa-fw([class]='getIcon(item)')
                .file-name([title]='item.name') {{item.name}}
                .me-auto
                .file-sync-icon(*ngIf='syncFor(item) as sync', [attr.data-state]='sync.state', [ngbTooltip]='fileSync.label(sync)|translate')
                    i([class]='fileSync.icon(sync)', [attr.aria-label]='fileSync.label(sync)|translate')
                .size(*ngIf='!item.isDirectory') {{item.size|filesize}}
                .date {{item.modified|tabbyDate}}
                .mode {{getModeString(item)}}
        .alert.alert-info.text-center.mt-3(*ngIf='fileList !== null && filteredFileList.length === 0 && showFilter && filterText.trim() !== ""')
            i.fas.fa-search.me-2
            span(translate='No files match the filter "{filter}"', [translateParams]='{filter: filterText}')

.file-status(role='status', aria-live='polite')
    ng-container(*ngIf='selectedFile as item; else editHint')
        .selected-name([title]='item.fullPath') {{item.name}}
        ng-container(*ngIf='syncFor(item) as sync; else editHint')
            .sync-state([attr.data-state]='sync.state', [title]='sync.error || (fileSync.label(sync)|translate)')
                i([class]='fileSync.icon(sync)', aria-hidden='true')
                span {{fileSync.label(sync)|translate}}
                button(type='button', *ngIf='sync.retry && (sync.state === "error" || sync.state === "pending")', (click)='retrySync(sync)', [attr.aria-label]='"Retry sync"|translate', [ngbTooltip]='"Retry sync"|translate')
                    i.fas.fa-rotate-right
            .sync-details(*ngIf='sync.syncedAt') {{ 'Last synced'|translate }}: {{sync.syncedAt|date:'HH:mm:ss'}}
            .sync-details.sync-error(*ngIf='sync.error') {{sync.error}}
    ng-template(#editHint)
        .sync-details(*ngIf='canEditFiles', translate) Double-click a file to edit; saved changes sync automatically.
        .sync-details(*ngIf='!canEditFiles', translate) Double-click to open
